COMPOSE_PROJECT_NAME=owl-platform

# 应用镜像；验证环境可保留 local，生产环境改为镜像仓库中的不可变版本
BACKEND_IMAGE=owl-platform-backend:local
FRONTEND_IMAGE=owl-platform-frontend:local
BACKEND_ENV_FILE=./deploy/env/backend.env

# 仅绑定宿主机回环地址，由宿主机 Nginx 对外代理
BIND_ADDRESS=127.0.0.1
BACKEND_PORT=5002
FRONTEND_PORT=7000

# Next.js 客户端变量在构建镜像时固化
NEXT_PUBLIC_API_URL=/owl/api
NEXT_PUBLIC_BASE_PATH=/owl
NEXT_PUBLIC_APP_NAME=Owl Platform 管理后台

# 后续启用 compose.middleware.yaml 时使用
POSTGRES_IMAGE=postgres:17-bookworm
POSTGRES_DB=owl_platform
POSTGRES_USER=owl
REDIS_IMAGE=redis:7.4-alpine
MINIO_IMAGE=quay.io/minio/minio:latest
MINIO_BUCKET=owl-platform
POSTGRES_PASSWORD_SECRET_FILE=./deploy/secrets/postgres_password
REDIS_PASSWORD_SECRET_FILE=./deploy/secrets/redis_password
MINIO_ACCESS_KEY_SECRET_FILE=./deploy/secrets/minio_access_key
MINIO_SECRET_KEY_SECRET_FILE=./deploy/secrets/minio_secret_key
