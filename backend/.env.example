# 本地源码开发模板 → 复制为 backend/.env；用于 npm run dev 与数据库命令。
# Docker 部署使用根目录 .env.example，不使用这份文件。
# 实际 .env 不提交 Git；已有配置先备份，切勿用模板覆盖真实凭证。

# ── 本地服务 ──
NODE_ENV=development
# 仅本机调试使用回环地址；后端端口变化时同步前端 VITE_DEV_PROXY_TARGET。
HOST=127.0.0.1
PORT=3001
# 是否将日志输出到终端；便于本地排错。
LOG_TO_STDOUT=true

# ── 数据库：必填 ──
# 每个项目使用独立 database 和账号；数据库本身需先存在，Prisma 负责建表和迁移。
# 宿主机运行填 127.0.0.1；容器连接宿主机填 host.docker.internal；远程填真实地址。
DB_HOST=127.0.0.1
# 数据库服务端口；容器连接宿主机时填写宿主机映射端口。
DB_PORT=5432
DB_NAME=owl_platform
DB_USER=owl
DB_PASSWORD=replace_with_database_password

# ── 首次初始化：仅创建空库数据时必填 ──
# admin 的初始密码，至少 12 位；初始化后修改此项不会重置已有账号密码。
INITIAL_ADMIN_PASSWORD=
# production 模式执行 db:bootstrap 时必须等于 DB_NAME；平时留空。
DB_BOOTSTRAP_CONFIRM=

# ── 登录令牌：必填 ──
# 分别执行 openssl rand -hex 32 生成两个独立值。更换后已有令牌失效。
JWT_SECRET=replace_with_independent_random_value
JWT_REFRESH_SECRET=replace_with_another_random_value
# 访问令牌与刷新令牌有效期，支持 24h / 7d 等格式。
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# ── 对象存储：必填，启动时会检查或创建 bucket ──
# 主机名或 IP，不带 http(s)://、路径或端口；端口与 TLS 分别配置。
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
# 对象存储账号与密钥，需允许访问指定 bucket；不要填写示例占位值。
MINIO_ACCESS_KEY=replace_with_minio_access_key
MINIO_SECRET_KEY=replace_with_minio_secret_key
MINIO_BUCKET=owl-platform

# ── Redis：可选 ──
# 用于验证码、缓存及部分授权功能。不可用时部分功能降级，不代表全部功能可用。
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# 未使用 ACL 用户或密码时留空；填写实际 Redis 凭证。
REDIS_USERNAME=
REDIS_PASSWORD=

# ── 浏览器访问与代理 ──
# 必填：前端的 origin（协议+域名+可选端口），不带 /owl 路径；多个用逗号分隔。
CORS_ORIGIN=http://127.0.0.1:5173
# Socket.IO 独立的允许 origin，单个前端地址，与上项保持一致。
SOCKET_CORS_ORIGIN=http://127.0.0.1:5173
# 信任的代理网络；直接公网访问时设 false，反向代理按实际网络填写。
TRUST_PROXY=loopback,linklocal,uniquelocal
# API 限流：窗口毫秒数和该窗口内请求上限（默认 15 分钟 / 100 次）。
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── 第三方密钥 / SQL API：启用对应功能时必填 ──
# 第三方密钥加密：32 字节，支持 64 位十六进制或 Base64。可用 openssl rand -hex 32。
# 已有加密数据后不要随意更换，否则原密钥无法解密。
THIRD_PARTY_SECRET_ENCRYPTION_KEY=
# SQL API Key 的摘要密钥，另生成独立随机值；更换会使已发放 API Key 校验失败。
API_KEY_PEPPER=
# 明文访问授权有效期，单位秒；该能力需要 Redis。
PLAIN_ACCESS_EXPIRY=600

# ── SMTP 邮件：可选，填写真实账号后启用发送 ──
# 邮件服务器主机，例如 smtp.example.com；SMTP_USER / SMTP_PASSWORD 未配置时禁用发送。
SMTP_HOST=
# 465 一般使用隐式 TLS（true）；587 一般设 false，由服务端协商 STARTTLS。
SMTP_PORT=465
SMTP_SECURE=true
# 发件认证账号；密码可能是邮箱供应商签发的 SMTP 授权码，而非网页登录密码。
SMTP_USER=
SMTP_PASSWORD=
# 收件人看到的发件名称；地址留空时使用 SMTP_USER，须符合供应商发件规则。
SMTP_FROM_NAME=Owl Platform
SMTP_FROM_EMAIL=

# ── 阿里云短信：可选，启用短信登录时配置 ──
# 阿里云 AccessKey，留空时不能发送短信；密码登录无需配置这组值。
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
# 控制台已审批的签名与模板 ID；地域默认为 cn-hangzhou。
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_REGION_ID=cn-hangzhou
# 短信服务类型：oneverify（短信认证）或 dysmsapi（普通短信）。
ALIYUN_SMS_SERVICE_TYPE=oneverify

# 仅主动执行 db:reset:dev 时填数据库名；该操作删除数据，正常启动保持空值。
DB_RESET_CONFIRM=
