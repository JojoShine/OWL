{
  "watch": [
    "src",
    "prisma",
    "scripts",
    "prisma.config.ts"
  ],
  "ignore": [
    "node_modules/",
    "logs/",
    "*.test.js",
    "*.spec.js",
    "src/generated/**",
    "dist/**"
  ],
  "ext": "js,ts,json,prisma",
  "env": {
    "NODE_ENV": "development"
  },
  "delay": 1000,
  "verbose": true,
  "restartable": "rs"
}
