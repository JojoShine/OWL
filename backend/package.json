{
  "name": "backend",
  "version": "1.0.0",
  "description": "owl管理系统 - 后端",
  "main": "dist/main.js",
  "scripts": {
    "dev": "nodemon --exec \"npm run build && node dist/main.js\"",
    "start": "node dist/main.js",
    "migrate": "node scripts/database-cli.js deploy",
    "db:init": "node scripts/database-cli.js bootstrap",
    "db:bootstrap": "node scripts/database-cli.js bootstrap",
    "db:deploy": "node scripts/database-cli.js deploy",
    "db:migrate": "node scripts/database-cli.js deploy",
    "db:status": "node scripts/database-cli.js status",
    "db:reset": "node scripts/database-cli.js reset-dev",
    "db:reset:dev": "node scripts/database-cli.js reset-dev",
    "db:init:full": "node scripts/database-cli.js reset-dev",
    "test": "jest --watchman=false",
    "build": "node -e \"require('fs').rmSync('dist', {recursive:true, force:true})\" && prisma generate && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "test:nest": "npm run build && jest --runInBand --watchman=false test/nest",
    "test:identity:db": "npm run build && OWL_DATABASE_TEST=1 jest --runInBand --watchman=false test/nest/identity.database.test.js",
    "db:baseline": "node scripts/database-cli.js baseline",
    "db:seed": "prisma db seed"
  },
  "keywords": [
    "nestjs",
    "prisma",
    "postgresql",
    "admin"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@alicloud/pop-core": "^1.8.0",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "axios": "1.15.2",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "geoip-lite": "^1.4.10",
    "handlebars": "4.7.9",
    "helmet": "^7.1.0",
    "joi": "^18.0.1",
    "jsonwebtoken": "^9.0.2",
    "minio": "^7.1.3",
    "morgan": "^1.10.0",
    "multer": "2.1.1",
    "node-cron": "^3.0.3",
    "nodemailer": "8.0.5",
    "pg": "^8.11.3",
    "redis": "^4.6.12",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "^4.8.1",
    "ssh2": "^1.17.0",
    "svg-captcha": "^1.4.0",
    "systeminformation": "5.31.6",
    "ua-parser-js": "^2.0.8",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1",
    "prisma": "7.10.0"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.7",
    "@types/express": "4.17.25",
    "@types/node": "22.20.5",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
