  @@index([folder_id], map: "idx_owl_files_folder_id")
  @@index([mime_type], map: "idx_owl_files_mime_type")
  @@index([original_name], map: "idx_owl_files_original_name")
  @@index([uploaded_by], map: "idx_owl_files_uploaded_by")
}

