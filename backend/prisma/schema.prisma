  login_at       DateTime                       @default(now()) @db.Timestamptz(6)
  last_active_at DateTime                       @default(now()) @db.Timestamptz(6)
  kicked_at      DateTime?                      @db.Timestamptz(6)
  status         enum_owl_user_sessions_status? @default(active)
  createdAt      DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                       @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?                      @map("deleted_at") @db.Timestamptz(6)
  created_by     String?                        @db.Uuid
  updated_by     String?                        @db.Uuid
  deleted_by     String?                        @db.Uuid

  @@index([created_by], map: "idx_owl_user_sessions_created_by")
