generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model owl_system_configs {
  id                   BigInt    @id
  logo_url             String?   @db.VarChar(500)
  login_bg_url         String?   @db.VarChar(500)
  company_name         String    @default("Owl Platform") @db.VarChar(100)
  system_name          String    @default("Owl Platform") @db.VarChar(100)
  show_tech_stack      Boolean   @default(true)
  registration_enabled Boolean   @default(true)
  tech_stack_info      Json?
  enable_theme_switch  Boolean   @default(true)
  theme_mode           String?   @default("auto") @db.VarChar(20)
  primary_color        String?   @default("default") @db.VarChar(20)
  created_by           String?   @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt            DateTime? @map("deleted_at") @db.Timestamptz(6)
  login_layout         String    @default("center") @db.VarChar(20)
  login_method         String?   @default("both") @db.VarChar(10)
  registration_method  String?   @default("both") @db.VarChar(10)
  updated_by           String?   @db.Uuid
  deleted_by           String?   @db.Uuid

  @@index([created_by], map: "idx_owl_system_configs_created_by")
}

model owl_users {
  id            String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username      String                 @db.VarChar(50)
  email         String                 @db.VarChar(100)
  password      String?                @db.VarChar(255)
  real_name     String?                @db.VarChar(50)
  phone         String?                @db.VarChar(20)
  avatar        String?                @db.VarChar(255)
  status        enum_owl_users_status? @default(active)
  last_login_at DateTime?              @db.Timestamptz(6)
  last_login_ip String?                @db.VarChar(45)
  createdAt     DateTime               @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime               @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?              @map("deleted_at") @db.Timestamptz(6)
  department_id String?                @db.Uuid
  access_level  String?                @default("SELF") @db.VarChar(30)
  created_by    String?                @db.Uuid
  updated_by    String?                @db.Uuid
  deleted_by    String?                @db.Uuid

  @@index([created_by], map: "idx_owl_users_created_by")
  @@index([department_id], map: "idx_owl_users_department_id")
  @@index([email], map: "idx_owl_users_email")
  @@index([phone], map: "idx_owl_users_phone")
  @@index([status], map: "idx_owl_users_status")
  @@index([username], map: "idx_owl_users_username")
}

model owl_roles {
  id          String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String                 @db.VarChar(50)
  code        String                 @db.VarChar(50)
  description String?                @db.VarChar(255)
  status      enum_owl_roles_status? @default(active)
  sort        Int?                   @default(0)
  createdAt   DateTime?              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime?              @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?              @map("deleted_at") @db.Timestamptz(6)
  created_by  String?                @db.Uuid
  updated_by  String?                @db.Uuid
  deleted_by  String?                @db.Uuid

  @@index([code], map: "idx_owl_roles_code")
  @@index([created_by], map: "idx_owl_roles_created_by")
  @@index([status], map: "idx_owl_roles_status")
}

model owl_permissions {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String    @db.VarChar(50)
  code        String    @db.VarChar(50)
  resource    String    @db.VarChar(50)
  action      String    @db.VarChar(50)
  description String?   @db.VarChar(255)
  category    String?   @db.VarChar(50)
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime? @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  created_by  String?   @db.Uuid
  updated_by  String?   @db.Uuid
  deleted_by  String?   @db.Uuid

  @@index([code], map: "idx_owl_permissions_code")
  @@index([created_by], map: "idx_owl_permissions_created_by")
  @@index([resource], map: "idx_owl_permissions_resource")
}

model owl_menus {
  id              String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parent_id       String?                @db.Uuid
  name            String                 @db.VarChar(50)
  path            String?                @db.VarChar(255)
  component       String?                @db.VarChar(255)
  icon            String?                @db.VarChar(50)
  type            enum_owl_menus_type?   @default(menu)
  visible         Boolean?               @default(true)
  sort            Int?                   @default(0)
  status          enum_owl_menus_status? @default(active)
  permission_code String?                @db.VarChar(50)
  createdAt       DateTime?              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime?              @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?              @map("deleted_at") @db.Timestamptz(6)
  menu_type       String?                @default("business") @db.VarChar(20)
  created_by      String?                @db.Uuid
  updated_by      String?                @db.Uuid
  deleted_by      String?                @db.Uuid

  @@index([created_by], map: "idx_owl_menus_created_by")
  @@index([parent_id], map: "idx_owl_menus_parent_id")
  @@index([status], map: "idx_owl_menus_status")
  @@index([type], map: "idx_owl_menus_type")
}

model owl_departments {
