  @@index([code], map: "idx_owl_departments_code")
  @@index([created_by], map: "idx_owl_departments_created_by")
  @@index([leader_id], map: "idx_owl_departments_leader_id")
  @@index([parent_id], map: "idx_owl_departments_parent_id")
  @@index([status], map: "idx_owl_departments_status")
