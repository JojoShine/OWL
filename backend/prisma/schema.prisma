  @@index([api_key], map: "idx_owl_third_party_api_keys_api_key")
  @@index([client_name], map: "idx_owl_third_party_api_keys_client_name")
  @@index([created_by], map: "idx_owl_third_party_api_keys_created_by")
  @@index([status], map: "idx_owl_third_party_api_keys_status")
}

