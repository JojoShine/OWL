NODE_ENV=production
HOST=0.0.0.0
PORT=3001
LOG_TO_STDOUT=true

# 当前验证环境连接已有中间件。同机服务使用 host.docker.internal，远程服务填写内网地址。
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=owl_platform
DB_USER=owl
DB_PASSWORD=replace_with_database_password

REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=replace_with_redis_password

MINIO_ENDPOINT=host.docker.internal
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=replace_with_minio_access_key
MINIO_SECRET_KEY=replace_with_minio_secret_key
MINIO_BUCKET=owl-platform

JWT_SECRET=replace_with_at_least_32_random_bytes
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=replace_with_another_32_random_bytes
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGIN=https://your-domain.example
TRUST_PROXY=loopback,linklocal,uniquelocal
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

THIRD_PARTY_SECRET_ENCRYPTION_KEY=replace_with_32_random_bytes
API_KEY_PEPPER=replace_with_an_independent_random_value

# 仅全新空库执行 db:bootstrap 时填写
INITIAL_ADMIN_PASSWORD=
DB_BOOTSTRAP_CONFIRM=
