# 前端公开配置模板；所有 VITE_ 值会进入浏览器，绝不能放后端密码或密钥。
# 本地开发：复制为 frontend/.env.development.local，改动后重启 Vite。
# 生产构建：复制为 frontend/.env.production，改动后重新 npm run build。
# 实际配置不提交 Git；不复制模板时使用程序默认值（开发 /，生产 /owl/）。

# ── 访问路径 ──
# 此示例按本地开发填写 /；生产若沿用 /owl/ 部署，将此项改为 /owl/。
# 路由和静态资源都受此值影响，须与 Nginx 站点路径一致。
VITE_BASE_PATH=/
# API 根地址；留空自动跟随上述路径（/api 或 /owl/api）。
# 跨域后端可填写完整 URL；不要包含 /system 后缀。
VITE_API_URL=

# ── 本地开发代理：只在 Vite 开发服务器中使用 ──
# 指向本地后端监听地址；生产构建由 Nginx 代理，不读取这个地址。
VITE_DEV_PROXY_TARGET=http://127.0.0.1:3001

# ── 独立服务地址：一般留空 ──
# 文件源地址，默认从 API 根地址推导。
VITE_BASE_URL=
# Socket.IO 服务 origin，默认浏览器当前 origin；连接路径跟随 VITE_BASE_PATH。
VITE_SOCKET_URL=

# ── 项目标识和主题 ──
# 项目唯一标识，用于隔离浏览器登录缓存和偏好；不同项目建议填写不同值。
VITE_PLATFORM_ID=
# 当前场景：general（通用）、government-service（政务）；沿用现有蓝色主题。
VITE_APP_SCENE=general

# ── 本机 UI 预览：真实联调保持 false ──
# true 仅用于开发模式的本机模拟展示；正式构建不会启用模拟身份。
VITE_UI_PREVIEW=false
# 是否禁用 Socket 连接；真实联调和正常构建保持 false。
VITE_DISABLE_SOCKET=false
