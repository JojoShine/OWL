# 公开构建配置；不要在 VITE_ 变量中放任何密钥。
# 开发默认 /，生产构建默认 /owl/；根路径部署显式填写 /
VITE_BASE_PATH=/owl/
# 留空使用同源 ${base}/api，兼容以 /api/system 结尾的旧配置
VITE_API_URL=
# 开发服务器代理目标（后端）；构建产物不依赖此地址
VITE_DEV_PROXY_TARGET=http://localhost:3001
# 可选：独立后端文件源 / Socket.io 源，默认同源
VITE_BASE_URL=
VITE_SOCKET_URL=
# 项目专用存储命名空间（不同项目使用不同值）
VITE_PLATFORM_ID=
# 当前预设 general（通用）或 government-service（政务）
VITE_APP_SCENE=general
# 仅本机开发演示，正式构建即使开启也不会创建预览登录身份
VITE_UI_PREVIEW=false
VITE_DISABLE_SOCKET=false
